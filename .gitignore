# Ignore everything in ArcGIS directory
ArcGIS/*
arcgis-experience-builder-*.zip
.temp*
*.npmrc

# But keep these specific folders
!ArcGIS/client/
ArcGIS/client/*
!ArcGIS/client/start-client.bat
!ArcGIS/client/your-extensions/
# Local installs inside the preserved extension tree. The widget keeps package-lock.json.
ArcGIS/client/your-extensions/**/node_modules/
ArcGIS/client/your-extensions/**/pnpm-lock.yaml

!ArcGIS/server/
ArcGIS/server/*
!ArcGIS/server/start-server.bat
!ArcGIS/server/public/
# Local Developer Edition OAuth; not present on later ExB trees.
ArcGIS/server/public/signin-info.json
__pycache__
/docs/_site
/tmp/
ArcGIS/server/public/apps/e2e-live/
