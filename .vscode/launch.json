{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Server",
      "command": "npm start -- --https_port 3001",
      "cwd": "${workspaceFolder}/ArcGIS/server",
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Client",
      "command": "npm start",
      "cwd": "${workspaceFolder}/ArcGIS/client",
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Debug in Chrome",
      "url": "https://localhost:3001",
      "webRoot": "${workspaceFolder}/ArcGIS/client",
      "sourceMapPathOverrides": {
        "webpack://exb-client/*": "${webRoot}/*"
      },
      "userDataDir": true,
      "presentation": {
        "hidden": true
      }
    },
    {
      "type": "msedge",
      "request": "launch",
      "name": "Debug in Edge",
      "url": "https://localhost:3001",
      "webRoot": "${workspaceFolder}/ArcGIS/client",
      "sourceMapPathOverrides": {
        "webpack://exb-client/*": "${webRoot}/*"
      },
      "userDataDir": true,
      "presentation": {
        "hidden": true
      }
    }
  ],
  "compounds": [
    {
      "name": "Start Debugging (Edge)",
      "configurations": ["Start Server", "Start Client", "Debug in Edge"],
      "stopAll": true
    },
    {
      "name": "Start Debugging (Chrome)",
      "configurations": ["Start Server", "Start Client", "Debug in Chrome"],
      "stopAll": true
    }
  ]
}
