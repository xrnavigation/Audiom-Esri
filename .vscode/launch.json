{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Server",
      "command": "npm start -- --https_port 3001",
      "cwd": "${workspaceFolder}/ArcGIS/server"
    },
    {
      "type": "node-terminal",
      "request": "launch",
      "name": "Start Client",
      "command": "npm start",
      "cwd": "${workspaceFolder}/ArcGIS/client"
    },
  ],
  "compounds": [
    {
      "name": "Full Debug (Edge)",
      "configurations": ["Start Server", "Start Client"],
      "stopAll": true
    },
    {
      "name": "Full Debug (Chrome)",
      "configurations": ["Start Server", "Start Client"],
      "stopAll": true
    }
  ]
}
